{
  "name": "course-knowledge-base",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/generate-remote-reference.mjs",
    "dev": "npm run generate && vitepress dev docs --host 127.0.0.1",
    "build": "npm run generate && vitepress build docs && node scripts/check.mjs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "check": "npm run build",
    "check:math": "python scripts/verify_math.py"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "playwright": "1.58.2",
    "vitepress": "1.6.4"
  }
}
